<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenDealer360.Vehicles</RootNamespace>
    <AssemblyName>OpenDealer360.Vehicles</AssemblyName>
    <!--
      Vehicles and what is on the lot (doc 04 §3). A vehicle is shared across the
      dealer organization; an inventory unit is one vehicle at one rooftop and is
      scoped to it. Owns the "vehicles" schema.
    -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
    <!-- Access decisions only, through Identity's published Contracts (ADR-008). -->
    <ProjectReference Include="..\Identity\Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
