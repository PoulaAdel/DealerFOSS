<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenDealer360.Modules.Organization</RootNamespace>
    <AssemblyName>OpenDealer360.Modules.Organization</AssemblyName>
    <!--
      The Organization capability: dealer organization, legal entities, rooftops,
      departments (doc 04 §1/§3). Owns its own tables; other modules reach it
      only through Contracts/IOrganizationDirectory (ADR-008).
    -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\OpenDealer360.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
