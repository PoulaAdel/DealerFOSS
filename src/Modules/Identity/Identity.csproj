<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenDealer360.Identity</RootNamespace>
    <AssemblyName>OpenDealer360.Identity</AssemblyName>
    <!--
      Users, roles, permissions, scoped assignments, and audit events
      (doc 04 §3). Owns the identity schema. Other modules ask it for access
      decisions through Contracts/IAccessDirectory (ADR-008).
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
