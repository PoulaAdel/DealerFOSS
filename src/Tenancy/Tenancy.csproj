<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenDealer360.Tenancy</RootNamespace>
    <AssemblyName>OpenDealer360.Tenancy</AssemblyName>
    <!--
      Infrastructure: the host catalog and tenant resolution (doc 03 §4,
      doc 04 §2/§5). May depend on EF Core; must NOT depend on ASP.NET Core
      (web concerns live in Host) or on any business module.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
