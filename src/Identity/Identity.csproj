<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DealerFOSS.Identity</RootNamespace>
    <AssemblyName>DealerFOSS.Identity</AssemblyName>
    <!--
      Users, roles, permissions, sessions, and the audit trail. A separate
      project so its tables and services are physically unreachable from the
      application: only IAccessDirectory and IAuthenticator are public
      (ADR-017). Owns the "identity" schema.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      A test-only seam. It lets the unit tests assert rules on Role and User
      without opening those types to the application, which is the wall this
      project exists to provide.
    -->
    <InternalsVisibleTo Include="Unit.Tests" />
    <!--
      The second-factor tests have to compute a valid TOTP code, which means
      reaching Totp. It stays internal rather than joining the public surface:
      it is pure maths that grants no access to anything, and the application has
      no reason to call it.
    -->
    <InternalsVisibleTo Include="IntegrationTests" />
  </ItemGroup>

</Project>
