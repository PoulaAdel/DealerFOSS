// Indiana — sales tax on a vehicle sale.
//
// WHY THIS PACK SHIPS WITHOUT ITS BASIS FLAGS, which is the first thing anyone
// reading it will ask. The RATE below is sourced: Indiana's Department of
// Revenue states a seven percent sales tax for the state, read on the date in
// fetchedAt. Indiana is a Streamlined Sales Tax full member and levies NO local
// sales tax, so the state rate is the whole rate for a car — which is why
// Indiana is a jurisdiction a single rate row can honestly describe, and why
// the 23 SST states as a block are not: without their ZIP+4 boundary files a
// state-level figure would undercharge a car by thousands in a state that does
// levy locally.
//
// What is NOT sourced is what Indiana taxes that rate ON — the trade-in
// allowance, the documentation fee, the government pass-through fees. That lives
// in Sales Tax Information Bulletin 28S, which nobody has read into this file.
// So "rules" is null rather than filled with the common-US answers, and the
// product REFUSES to mark this pack supported until a person decides all three.
// A Draft pack resolves nothing, so nothing is charged from it in the meantime.
//
// Filling them in by copying what most states do would be the worst available
// option: it would look reviewed, it would be wrong wherever Indiana differs,
// and it would carry a pack's name onto the invoice while being somebody's
// guess. ADR-024 is explicit that a rotted pack is worse than none, precisely
// because it is trusted.
//
// TO FINISH THIS PACK: read Bulletin 28S, set the three flags, raise version to
// 2, and load it as a new generation. Do not edit this file in place — the
// version already loaded is what some deal was taxed under (ADR-024 R2).
{
  "packId": "us-in",
  "country": "US",
  "scheme": "Sst",
  "version": 1,

  // Indiana's rate has stood at 7 percent since 2008. This date is the start of
  // the window this pack CLAIMS, not the start of the rate's life: a pack
  // asserts what it was checked against, and it was checked in 2026.
  "effectiveFrom": "2026-01-01",
  "effectiveTo": null,

  "sourceUri": "https://www.in.gov/dor/i-am-a/business-corp/sales-tax/",
  "fetchedAt": "2026-10-13T00:00:00Z",

  // Absent on purpose. See the note above.
  "rules": null,

  "rates": [
    {
      "jurisdictionCode": "US-IN",
      "description": "Indiana sales tax",
      "rateKind": "State",

      // A FRACTION, not a percentage. Seven percent is 0.07.
      "rate": 0.07,

      // Matches any address whose state is IN, at any county and any postcode,
      // because Indiana has no local sales tax to narrow it down to. A county or
      // postal matcher here would be a claim that the rate varies within the
      // state, which it does not.
      "administrativeArea": "IN",
      "county": null,
      "postalKey": null,

      "effectiveFrom": "2026-01-01",
      "effectiveTo": null,
      "sourceUri": "https://www.in.gov/dor/i-am-a/business-corp/sales-tax/"
    }
  ]
}
