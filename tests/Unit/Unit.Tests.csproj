<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DealerFOSS.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Domain and kernel rules, tested in isolation. No database, no HTTP, no
    fixtures — if a test here needs infrastructure it belongs in
    tests/Integration instead.
  -->

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\src\Identity\Identity.csproj" />
    <ProjectReference Include="..\..\src\App\App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />

    <!--
      The fake authenticator writes CBOR, because a passkey test that does not
      produce a real signature over real authenticator data proves nothing.
    -->
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>

</Project>
