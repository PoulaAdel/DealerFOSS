<Project>

  <!--
    Central package version management (ADR / stack: "versions pinned centrally").
    Projects reference packages by name only; versions live here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistence -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />

    <!--
      TRANSITIVE, pinned forward rather than referenced. Microsoft.Data.SqlClient
      6.1.1 — which arrives under EntityFrameworkCore.SqlServer — asks for
      System.Security.Cryptography.Pkcs 9.0.4, and two advisories landed against
      that version: GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7
      (moderate). NuGetAudit is warnings-as-errors, so the whole solution stopped
      building for every session at once.
      Pinning works because CentralPackageTransitivePinningEnabled is on above;
      no project references this package by name and none should. Drop this line
      once SqlClient's own dependency moves past 9.0.4 — it is a patch for
      somebody else's graph, not a dependency of ours.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

    <!--
      CBOR, for reading the public key out of a passkey registration. Microsoft's
      own BCL package rather than a FIDO library: a passkey needs one binary
      format decoded and two signature algorithms verified, and pulling a whole
      attestation stack into the sealed Identity project to get that would be a
      much larger security dependency than the problem calls for.

      10.0.15, not 10.0.0: GHSA-vmv3-wvjp-wqpj (moderate) affects every 10.0.x
      below 10.0.15, and the advisory appeared with no change on our side.
    -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Hosting as a Windows service. Referenced unconditionally rather than behind
      a Windows-only condition: the package restores everywhere, and
      UseWindowsService() is a no-op when the process is not running under the
      service control manager. A conditional reference would mean the Linux build
      and the Windows build were different programs.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Observability -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

</Project>
