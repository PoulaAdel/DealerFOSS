# Copy to deploy/.env and fill in. That file is git-ignored; this one is not.
#
#   Copy-Item deploy/.env.example deploy/.env
#   & .\deploy\new-key.ps1 -Format env
#
# Every value below has no default in docker-compose.app.yml. Compose fails
# loudly if one is missing, which is the intended behaviour — an installation
# started without a key is one whose backups cannot be restored, and that is not
# discovered until the day it matters.

# The database's administrator password. SQL Server rejects anything under 8
# characters or without three of: upper, lower, digit, symbol.
SQL_SA_PASSWORD=

# Developer is free and full-featured but licensed for non-production use only.
# Express is free for production with a 10 GB per-database limit. Standard and
# Enterprise need a licence you hold.
SQL_EDITION=Developer

# Names the key, so a later one can be added beside it. Dated by convention.
SECRETS_KEY_ID=

# 32 bytes, base64. Generate with: & .\deploy\new-key.ps1 -Format env
#
# BACK THIS UP SOMEWHERE OTHER THAN THIS MACHINE. Every tenant's connection
# string is encrypted with it, so a database backup without the key is not a
# backup.
SECRETS_KEY=

# What the application is reachable on, from the host.
APP_PORT=8080
